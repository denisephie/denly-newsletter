# Copy to .env and fill in. Real environment variables override values in this file.

# Twilio
TWILIO_ACCOUNT_SID=                          # TODO(me): from the Twilio console
TWILIO_AUTH_TOKEN=                           # TODO(me): from the Twilio console
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox number by default; TODO(me): own sender later
TWILIO_NIGHT_TEMPLATE_SID=                   # TODO(me): Content SID, needed when 24h window is closed
TWILIO_MORNING_TEMPLATE_SID=                 # optional, same idea

# Me
MY_WHATSAPP_NUMBER=whatsapp:+65XXXXXXXX      # TODO(me): E.164 format

# Anthropic
ANTHROPIC_API_KEY=                           # TODO(me)
ANTHROPIC_MODEL=                             # TODO(me): pick a model; a small/fast one is plenty, e.g. claude-haiku-5-5

# App
PUBLIC_BASE_URL=                             # TODO(me): the https URL Twilio calls (ngrok or deployed)
DB_PATH=./data/todo.db
PORT=8000
DRY_RUN=false                                # true = print messages to console instead of sending
SKIP_SIGNATURE=false                         # only honoured when DRY_RUN=true (local curl testing)
